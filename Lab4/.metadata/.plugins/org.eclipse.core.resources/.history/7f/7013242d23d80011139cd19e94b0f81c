#ifndef INC_SCHEDULER_H_
#define INC_SCHEDULER_H_

#include "stdint.h"

// Định nghĩa cấu trúc của một Task (Công việc)
typedef struct {
    void (*pTask)(void); // Con trỏ chỉ đến hàm sẽ thực thi
    uint32_t Delay;      // Thời gian chờ (tính bằng số tick) cho lần chạy tiếp theo[cite: 73]
    uint32_t Period;     // Chu kỳ lặp lại (tính bằng số tick)[cite: 73]
    uint8_t RunMe;       // Cờ báo hiệu (khi > 0 nghĩa là task đã đến giờ chạy)[cite: 73]
    uint32_t TaskID;     // Mã ID của task[cite: 73]
} sTask;

#define SCH_MAX_TASKS 40 // Số lượng task tối đa mà hệ thống có thể chứa[cite: 73]

// Khai báo các hàm quản lý
void SCH_Init(void);
void SCH_Update(void);
uint32_t SCH_Add_Task(void (*pFunction)(), uint32_t DELAY, uint32_t PERIOD);
void SCH_Dispatch_Tasks(void);
uint8_t SCH_Delete_Task(uint32_t TASK_INDEX);

#endif /* INC_SCHEDULER_H_ */