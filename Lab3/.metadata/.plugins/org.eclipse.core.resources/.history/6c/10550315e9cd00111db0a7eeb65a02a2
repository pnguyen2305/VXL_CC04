#include "input_processing.h"
#include "input_reading.h"

int system_mode = 1;

int red_duration = 5;
int amber_duration = 2;
int green_duration = 3;
int temp_red = 5;
int temp_amber = 2;
int temp_green = 3;

int btn1_flag = 0;
int btn2_flag = 0;
int btn3_flag = 0;

void fsm_for_input_processing(void) {
    if (is_button_pressed(0)) {
        if (btn1_flag == 0) {
            btn1_flag = 1;

            system_mode++;
            if (system_mode > 4) system_mode = 1;
            if (system_mode == 2) temp_duration = red_duration;
            if (system_mode == 3) temp_duration = amber_duration;
            if (system_mode == 4) temp_duration = green_duration;
        }
    } else {
        btn1_flag = 0;
    }

    if (is_button_pressed(1)) {
        if (btn2_flag == 0) {
            btn2_flag = 1;
            if (system_mode == 2 || system_mode == 3 || system_mode == 4) {
                temp_duration++;
                if (temp_duration > 99) temp_duration = 1;
            }
        }
    } else {
        btn2_flag = 0;
    }

    if (is_button_pressed(2)) {
        if (btn3_flag == 0) {
            btn3_flag = 1;
            if (system_mode == 2) red_duration = temp_duration;
            if (system_mode == 3) amber_duration = temp_duration;
            if (system_mode == 4) green_duration = temp_duration;
        }
    } else {
        btn3_flag = 0;
    }
}
